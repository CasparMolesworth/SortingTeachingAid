<Window x:Class="SortingVisualiser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SortingVisualiser"
        mc:Ignorable="d"
        Title="MainWindow" Height="900" Width="1600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--Top Buttons-->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10" HorizontalAlignment="Center">
            <Button x:Name="RandomiseButton" Content="Randomise Array" Margin="5" Width="120" Height="30" Click="RandomiseButton_Click"/>
            <Label Content="Size:" VerticalAlignment="Center" Height="30" Margin="5" Background="LightGray"/>
            <TextBox x:Name="SizeInput" Text="10" Width="60" Margin="5" TextAlignment="Center"/>
            <Button x:Name="BubbleSortButton" Content="Bubble Sort" Margin="5" Width="120" Height="30" Click="BubbleSortButton_Click" IsEnabled="False"/>
            <Button x:Name="InsertionSortButton" Content="Insertion Sort" Margin="5" Width="120" Height="30" Click="InsertionSortButton_Click" IsEnabled="False"/>
            <Button x:Name="MergeSortButton" Content="Merge Sort" Margin="5" Width="120" Height="30" Click="MergeSortButton_Click" IsEnabled="False"/>
            <Label x:Name="EnableAnimationLabel" Content="Enable Animation:" VerticalAlignment="Center" Height="30" Margin="5" Background="LightGray"/>
            <CheckBox x:Name="EnableAnimationCheckBox" VerticalAlignment="Center" Height="30" Margin="5" Checked="AnimationEnabledCheckBox_Checked" Unchecked="AnimationEnabledCheckBox_Unchecked"/>
            <Label x:Name="ElapsedTimeLabel" Content="Elapsed Time:" VerticalAlignment="Center" Height="30" Margin="5" Background="LightGray"/>
            <Label x:Name="ActualTimeLabel" Content="0 ms" VerticalAlignment="Center" Height="30" Margin="5" />
        </StackPanel>

        <!--Main Panel-->
        <UniformGrid Grid.Row="1" x:Name="VisualisingPanel" Rows="1" VerticalAlignment="Bottom"/>
    </Grid>
</Window>

    