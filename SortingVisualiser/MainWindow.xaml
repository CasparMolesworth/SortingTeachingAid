<Window x:Class="SortingVisualiser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SortingVisualiser"
        mc:Ignorable="d"
        Title="MainWindow" Height="320" Width="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Label Content="Sorting Visualiser" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Margin="10" Grid.Row="0"/>
        <Button Content="Open Comparison View" Margin="10" Click="OpenComparisonViewButton_Click" Grid.Row="1" Width="200" Height="30"/>
        <Button Content="Animated Bubble Sort" Margin="10" Click="OpenAnimatedBubbleSortButton_Click" Grid.Row="2" Width="200" Height="30" IsEnabled="False"/>
        <Button Content="Animated Insertion Sort" Margin="10" Click="OpenAnimatedInsertionSortButton_Click" Grid.Row="3" Width="200" Height="30" IsEnabled="False"/>
        <Button Content="Animated Merge Sort" Margin="10" Click="OpenAnimatedMergeSortButton_Click" Grid.Row="4" Width="200" Height="30" IsEnabled="False"/>
        <Label Content="By Caspar Molesworth" Grid.Row="5" Margin="5"/>
    </Grid>
</Window>

    